NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sansight?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-cookie-secret
ENCRYPTION_KEY=replace-with-32-char-minimum-secret
WORLD_ID_APP_ID=app_staging_xxxxx
WORLD_ID_ACTIONS=sans-auth
ML_SERVICE_URL=http://ml-service/predict
AWS_REGION=us-east-1
AWS_S3_BUCKET=sansight-uploads
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
